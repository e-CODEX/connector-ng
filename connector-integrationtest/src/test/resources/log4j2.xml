<Configuration status="WARN">
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%style{%d{yyyy-MM-dd HH:mm:ss}}{cyan} %highlight{%-5level}{FATAL=bg_red,ERROR=red,WARN=yellow,INFO=green,DEBUG=blue,TRACE=cyan} %style{[%t]}{yellow} %style{[%X{traceId:-}]}{blue} %style{%c{1}}{magenta} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Package-specific logging -->
        <Logger name="eu.ecodex.connector" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- Root logger -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
