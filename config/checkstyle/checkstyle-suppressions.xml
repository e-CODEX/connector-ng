<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Suppress checks for test files -->
    <suppress files=".*Test\.java$"
              checks="LineLength|MissingJavadocMethod|MissingJavadocType"/>
    <suppress files=".*Tests\.java$"
              checks="LineLength|MissingJavadocMethod|MissingJavadocType"/>
    <suppress files=".*[/\\]src[/\\]test[/\\].*\.java$"
              checks="LineLength|MissingJavadocMethod|MissingJavadocType"/>

    <!-- Suppress checks for Gradle-generated sources -->
    <suppress files=".*[/\\]build[/\\]generated[/\\].*\.java$" checks=".*"/>

    <!-- Suppress checks for vendored JAXB schema bindings -->
    <suppress files=".*[/\\]oasis[/\\].*\.java$" checks=".*"/>
    <suppress files=".*[/\\]org[/\\]etsi[/\\].*\.java$" checks=".*"/>
    <suppress files=".*[/\\]org[/\\]w3[/\\].*\.java$" checks=".*"/>
    <suppress files=".*[/\\]eu[/\\]spocseu[/\\].*\.java$" checks=".*"/>
</suppressions>
